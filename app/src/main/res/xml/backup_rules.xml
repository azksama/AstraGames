<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- PIN and F95 cookies are encrypted with a non-transferable Android Keystore key.
         Restoring these preferences would leave the app locked with an unreadable PIN. -->
    <exclude domain="file" path="datastore/astra_settings.preferences_pb" />
    <exclude domain="database" path="astra_games.db-shm" />
    <exclude domain="database" path="astra_games.db-wal" />
</full-backup-content>
